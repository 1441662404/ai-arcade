# 统一换行符（仓库内以 LF 存储）
* text=auto

# ---------- 二进制文件：禁止 Git 做文本 diff / 换行转换 ----------
*.glb   binary
*.gltf  binary
*.bin   binary
*.fbx   binary
*.wasm  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.mp4   binary
*.zip   binary
*.gz    binary

# ---------- Windows 脚本：保持 CRLF，否则双击无法运行 ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---------- 其他 ----------
*.md    text
*.js    text
*.json  text
*.html  text
*.css   text
*.yml   text
